[gd_scene format=3]

[node name="StartScreen" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 64
text = "Where Boar"
horizontal_alignment = 1

[node name="Goal" type="Label" parent="Box"]
layout_mode = 2
text = "Kill or catch as many boars as you can. Fleeing boars escape through the red zones.
Return to the green camp zone and press E to end the hunt early."
horizontal_alignment = 1

[node name="Start" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Start hunt"
